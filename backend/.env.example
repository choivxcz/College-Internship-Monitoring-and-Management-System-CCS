NODE_ENV=development
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
# The system uses MySQL (8.0 or later). `npm run db:migrate` creates the database if it is missing.
# Set DB_USER/DB_PASSWORD to a MySQL account allowed to create the DB_NAME database.
# To run without a database server instead, set DB_DIALECT=sqlite (data is kept in DB_STORAGE).
DB_DIALECT=mysql
DB_STORAGE=./data/internship_hub.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=internship_hub
DB_USER=root
DB_PASSWORD=
# Seed creates accounts only when absent; it never changes existing passwords.
ADMIN_EMAIL=admin@lspu.edu.ph
ADMIN_NAME=Internship Coordinator
ADMIN_PASSWORD=
# Optional fictional data and student account, disabled by default.
SEED_DEMO=false
DEMO_STUDENT_PASSWORD=
